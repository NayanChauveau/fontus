# Local Supabase (pnpm supabase:start)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres
# DATABASE_POOL_MAX=5
# DATABASE_SSL=0

# Sentry (prod). Leave empty in local.
# SENTRY_DSN=

# Prod Traefik host (docker-compose.prod.yml)
# TRAEFIK_HOST=fontus.fr
# POSTGRES_PASSWORD=

# Dossier local des fichiers DIS data.gouv (UDI_COM, PLV, RESULT). Optionnel.
# DIS_IMPORT_DIR=data/dis
